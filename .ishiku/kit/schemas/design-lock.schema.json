{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishiku.dev/schemas/design-lock.schema.json",
  "title": "ishiku app design binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "application", "implementation"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"const": "ishiku-design-5"},
        "version": {"type": "string", "pattern": "^5\\.\\d+\\.\\d+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authentication", "locale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "authentication": {"enum": ["standard-account", "dropiku-totp-vault", "meiku-client-vault"]},
        "locale": {"const": "en"}
      }
    },
    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "roles"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["tokens", "components", "theme-controller", "icons"]}}
        }
      }
    }
  }
}
