{
  "name": "dropiku",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hosted file exchange for short-lived uploads and capability links.",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "cli": "node dist/server/cli.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "mime-types": "^3.0.2",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
